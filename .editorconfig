# .editorconfig
# https://editorconfig.org

root = true

# ---------------------------------------------------------
# General
# ---------------------------------------------------------

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------------------------------------------------------
# C / C++
# ---------------------------------------------------------

[*.{c,cc,cpp,cxx,h,hpp,hxx,inl}]
indent_style = space
indent_size = 4
tab_width = 4

# ---------------------------------------------------------
# CMake
# ---------------------------------------------------------

[*.cmake]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# JSON / YAML / TOML
# ---------------------------------------------------------

[*.json]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# Markdown
# ---------------------------------------------------------

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
